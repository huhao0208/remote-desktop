# 填你的 VPS 公网 IP 或域名（客户端会用它连 8443 与 3478）
PUBLIC_HOST=1.2.3.4
# coturn 的 HMAC 共享密钥，随机长串
TURN_SECRET=change_me_to_a_long_random_secret# coturn 实际监听/中继用的**内网网卡 IP**（VPS 常是 NAT 型：公网 IP 不在网卡上）
# 查法：ip -4 addr show 里那块能出网的网卡地址，例如 172.18.58.181
# 不填会退化为只绑 127.0.0.1 + docker 网桥，公网 TURN 不可用（实测踩过）
TURN_PRIVATE_IP=172.18.58.181
