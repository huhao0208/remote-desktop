# 证书与私钥：绝不入库（部署时单独放到 srv2/certs/）
*.pem
*.key
*.crt
*.p12
certs/
proxy/confdir/

# 逆向产物与客户端安装包：体积大且有版权风险，不入库
*.apk
*.exe
apk-dec/
jadx-out/
pc_extract/
srv/
uuyc.apk
uu_setup.exe

# 凭据与运行数据
.env
.env.*
!.env.example
data/
*.db
*.db-wal
*.db-shm
*.jsonl
capture/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
proxy/venv/

# 临时日志
*.log
/tmp/
# 逆向抓包与官方页面快照（可能含会话标识 / 官方素材）
headers.txt
*.html
pc.json
# 只忽略仓库根目录的 lib/（逆向产物），不能误伤 client-flutter/lib/
/lib/

# 本项目自己的页面必须入库（上面 *.html 只用于逆向快照）
!srv2/control.html

# 客户端工程：源码入库，依赖与构建产物不入库
node_modules/
client-desktop/release/
client-desktop/bin/
client-desktop/web/
client-mobile/www/
client-mobile/android/.gradle/
client-mobile/android/build/
client-mobile/android/app/build/
client-mobile/android/local.properties
client-mobile/ios/App/Pods/
client-mobile/ios/**/xcuserdata/
*.dmg
*.tar.gz
build_tmp*/
dist/
data-local/

# PyInstaller spec（--specpath . 会在仓库根生成）
*.spec
