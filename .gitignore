*.key
*.crt
*.p12
certs/
proxy/confdir/

# 逆向产物与客户端安装包：体积大且有版权风险，不入库
*.apk
*.exe
apk-dec/
jadx-out/
pc_extract/
srv/
uuyc.apk
uu_setup.exe

