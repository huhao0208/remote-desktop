{
  "name": "uu-remote-client",
  "productName": "UU远程桌面",
  "version": "1.0.0",
  "description": "远程桌面控制端客户端（Windows / macOS / Linux）",
  "main": "main.js",
  "author": "huhao0208",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync-web.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder",
    "dist:mac": "npm run sync && electron-builder --mac",
    "dist:win": "npm run sync && electron-builder --win",
    "dist:linux": "npm run sync && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.huhao.uuremote",
    "productName": "UU远程桌面",
    "artifactName": "uu-remote-client-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "bin", "to": "agent", "filter": ["**/*"] }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Utility"
    }
  }
}